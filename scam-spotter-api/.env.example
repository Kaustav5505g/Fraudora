# --- Supabase (scan history) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Server-side secret key (service_role / sb_secret_...). NEVER put this in the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# true  = store the pasted message so a past scan can be re-opened with highlights
# false = store only score, level, rule ids (no message text, no full URLs)
STORE_MESSAGE_TEXT=true

# --- Gemini (plain-English explanation, optional) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Gemini is only called when the rule score is at least this high
LLM_MIN_SCORE=30

# --- Link reputation (both optional, use one or both) ---
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
VT_MIN_MALICIOUS=2

# --- API ---
# Comma-separated list, e.g. https://your-frontend.vercel.app,http://localhost:5173
CORS_ORIGINS=*
